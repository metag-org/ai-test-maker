# ===== NAS 生产配置 (复制到 NAS 后重命名为 .env，配合 docker-compose.nas.yml) =====
APP_PORT=8089

# 请先在 NAS 的 PostgreSQL 中创建独立数据库（例：CREATE DATABASE review_test;）
# 主机名填写 nas-shared-net 中 Postgres 容器的服务名或容器名
DATABASE_URL=postgresql://your_pg_user:your_pg_password@your_postgres_container:5432/review_test

# 家庭内网默认免登录（留空即可）；如需加锁请填写密码
APP_PASSWORD=
SECRET_KEY=
